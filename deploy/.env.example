# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32   (keys)   and   openssl rand -base64 24   (passwords)

# Public address. Point its DNS A record at the server before the first start so HTTPS certificates can be issued.
DOMAIN=app.example.com
# Only when the public address is not https://DOMAIN (for example a non-standard port): the full URL.
PUBLIC_URL=

# Database passwords: the owner runs migrations and backups; the app role is what the API uses (row-level security applies to it).
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Encryption keys: 64 hex characters each. Losing FILE_ENC_KEY makes stored documents unreadable; keep a copy offline.
MFA_ENC_KEY=
FILE_ENC_KEY=

# Backups: encrypted with this passphrase. Store it separately from the server (a password manager).
BACKUP_PASSPHRASE=
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=02

# Push notifications (VAPID). Generate once:  npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@example.com

# WhatsApp Cloud API (leave empty until the Meta app is set up; WhatsApp then stays "awaiting credentials").
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=961

# Email provider (not wired yet).
EMAIL_PROVIDER_API_KEY=

SESSION_TTL_HOURS=12
HTTP_PORT=80
HTTPS_PORT=443
