{
  "name": "@medora/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json && node dist/src/main.js",
    "test": "npm run build && node --test --test-timeout=30000 --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "vercel-build": "cd ../.. && npm run build -w @medora/shared && npm run build -w @medora/api"
  },
  "dependencies": {
    "@medora/shared": "*",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/platform-ws": "^12.6.2",
    "@nestjs/websockets": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^4.0.0",
    "ws": "^8.23.0"
  },
  "type": "module",
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  }
}
